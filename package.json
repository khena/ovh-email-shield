{
  "name": "ovh-email-shield",
  "version": "1.1.1",
  "type": "module",
  "description": "Cross-browser WebExtension (Firefox & Chrome) to generate disposable email aliases using OVH API",
  "homepage": "https://github.com/khena/ovh-email-shield",
  "repository": {
    "type": "git",
    "url": "https://github.com/khena/ovh-email-shield.git"
  },
  "scripts": {
    "test": "node --test tests/*.test.js",
    "start": "web-ext run",
    "lint": "web-ext lint",
    "build": "node scripts/build.js all",
    "build:firefox": "node scripts/build.js firefox",
    "build:chrome": "node scripts/build.js chrome",
    "build:web-ext": "web-ext build --overwrite-dest",
    "deploy:firefox": "web-ext sign --source-dir dist/firefox --channel listed --approval-timeout 0",
    "bump": "node scripts/bump-version.js",
    "postversion": "node scripts/bump-version.js && git add manifest.json manifest.firefox.json manifest.chrome.json"
  },
  "keywords": [
    "firefox",
    "webextension",
    "ovh",
    "email-alias",
    "privacy"
  ],
  "author": "",
  "license": "MPL-2.0",
  "devDependencies": {
    "web-ext": "^10.7.0"
  },
  "webExt": {
    "ignoreFiles": [
      ".github",
      ".github/**",
      ".agents",
      ".agents/**",
      "scripts",
      "scripts/**",
      "conductor",
      "conductor/**",
      "tests",
      "tests/**",
      "GEMINI.md",
      "*.md",
      "dist",
      "dist/**",
      "manifest.*.json",
      "package.json",
      "package-lock.json",
      "skills-lock.json"
    ],
    "build": {
      "overwriteDest": true
    }
  }
}
